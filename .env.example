# Copy to .env and fill in. .env is gitignored. Never paste these values into chat.

# Anthropic key from Flashpoint
ANTHROPIC_API_KEY=

# Private key of a SELF-CUSTODY wallet on Base (0x + 64 hex chars).
# Only needed for real x402 payments. Use a small "hot" wallet with a few dollars.
WALLET_PRIVATE_KEY=

# Public address of that wallet (safe to share). Used by the balance check.
WALLET_ADDRESS=

# Flashpoint x402 settings (fill in from their docs / staff)
FLASHPOINT_BASE_URL=
FLASHPOINT_ENDPOINT=

# Spending cap per run, in USD. Scripts refuse to pay more than this.
X402_MAX_USD=0.25

# Base mainnet RPC (public default is fine for a hackathon)
BASE_RPC_URL=https://mainnet.base.org
