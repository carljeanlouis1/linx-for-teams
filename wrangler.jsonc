// Public, SIMULATED-ONLY deploy of the LINX demo. No wallet key is ever uploaded here.
{
  "name": "linx-for-teams",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4402", "simple": { "limit": 12, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
